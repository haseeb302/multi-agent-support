# Copy to .env and fill in values
# cp .env.example .env

# Environment
APP_ENV=development

# Pinecone (https://docs.pinecone.io/guides/get-started/overview)
# Required: API key and index name. Optional: dimension, model, region, namespace.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name

# Optional Pinecone (tweak as needed; index may already exist with integrated embedding)
# PINECONE_DIMENSION=1536
# PINECONE_MODEL_NAME=llama-text-embed-v2
# PINECONE_REGION=us-east-1
# PINECONE_NAMESPACE=__default__
# PINECONE_TEXT_FIELD=text   # record field for embeddable text (must match index field_map: "text" or "chunk_text")

# LLM (for chat/agents)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini

# Optional: override paths to data files
# CUSTOMERS_CSV_PATH=docs/customers.csv
# RETENTION_RULES_PATH=docs/retention_rules.json
# CUSTOMER_UPDATES_LOG_PATH=data/customer_updates.log
